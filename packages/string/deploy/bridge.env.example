# crew-messenger agent-box bridge environment.
# Copy to ~/.config/crew-messenger/bridge.env (0600). NO SECRETS HERE — the capability token is a
# separate 0600 file referenced by CREW_BRIDGE_TOKEN_FILE; this file only points at it.

# The hub to dial. Production ingress is the Cloudflare Tunnel in front of the hub.
CREW_BRIDGE_HUB_URL=wss://hub.h1r.ai

# This bridge's identity. Must match the bridgeId the hub token was minted for.
CREW_BRIDGE_ID=agentbox

# The agents this bridge serves — EXACTLY the names the hub token authorizes, comma-separated.
# FIRST LIVE STEP IS ONE AGENT: start with just nova, then widen once end-to-end is proven.
# Authorized Claude Code agents (the hub token's roster): ada aria keel leo nova scout suri vega vera.
# Codex (node) sessions atlas, milo, pike must NOT be listed — they never read-ack String events, so
# their mail would queue forever; the bin refuses to start if any is present (see below).
CREW_BRIDGE_AGENTS=nova

# Agents the bridge must refuse to serve (Codex sessions). Defaults to the known Codex roster; only
# override if that roster changes. A denied agent in CREW_BRIDGE_AGENTS is a hard start failure.
# CREW_BRIDGE_DENY_AGENTS=atlas,milo,pike

# The capability token, as a 0600 file (minted on V1, handed to this bridge operator). Never inline.
CREW_BRIDGE_TOKEN_FILE=__HOME__/.config/crew-messenger/agentbox.token

# Where the per-agent dedup maps (messageId -> eventId) are kept. Bridge-owned, outside any agent home.
CREW_BRIDGE_STATE_DIR=__HOME__/.local/state/crew-messenger-bridge

# Local stringd — defaults are fine on the agent box. STRING_DAEMON_URL overrides STRING_PORT.
# STRING_PORT=3923
# STRING_DAEMON_URL=http://127.0.0.1:3923

# Heartbeat cadence (ms). Default 15000; engages the hub's S6 liveness + required alarm path.
# CREW_BRIDGE_HEARTBEAT_MS=15000
