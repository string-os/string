---
const installCommand = `npm install -g @string-os/string`;
const skillUrl = `https://www.string-os.org/skill.md`;
const agentInstruction = `Read ${skillUrl} and follow the instructions.`;

const weatherApp = `---
name: weather
type: app
default: now
---

# Weather

\`\`\`act.now
GET https://wttr.in/{city}?format=%l:+%c+%t
  city, -c: string (required) "City name"
\`\`\`

\`\`\`act.forecast
GET https://wttr.in/{city}?format=j1
  city: string (required) "City name"
  days: number (optional) "Days to forecast" = "3"
\`\`\``;

const agentSession = `$ string app:weather '/act.now --city Seoul'

<𝒞=string:app:weather>
Seoul: ☀️ +23°C
</𝒞>

$ string app:weather '/act.forecast --city Tokyo --days 5'

<𝒞=string:app:weather>
Tokyo, 5-day forecast:
  Mon: ☀️ +28°C
  Tue: 🌤 +27°C
  Wed: 🌧 +22°C
  Thu: ⛅ +25°C
  Fri: ☀️ +29°C
</𝒞>`;

const surfaces = [
  { kind: 'read',       domain: 'documents',   verb: '/open file.md' },
  { kind: 'structured', domain: 'apps',        verb: '/act.<name>' },
  { kind: 'remote',     domain: 'the web',     verb: '/open https://…' },
  { kind: 'write',      domain: 'editing',     verb: '/edit · /write' },
  { kind: 'execution',  domain: 'shell · API', verb: '/exec · act.cli' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="String — a universal surface for AI agent work. One interface to read, navigate, act, and edit across documents, apps, and the web." />
    <meta property="og:title" content="String — a surface for agent work" />
    <meta property="og:description" content="The web gave humans a universal surface for information. String gives AI agents a universal surface for work." />
    <meta property="og:url" content="https://string-os.org" />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>String — a surface for agent work</title>
  </head>
  <body>
    <nav class="top">
      <a class="brand" href="/"><img class="brand-logo" src="/string-logo.png" alt="String" /></a>
      <div class="nav-links">
        <a href="https://docs.string-os.org">Docs</a>
        <a href="/skill.md">skill.md</a>
        <a href="https://github.com/string-os/string">GitHub</a>
      </div>
    </nav>

    <!-- HERO -->
    <header class="hero">
      <img class="hero-logo" src="/string-logo.png" alt="String" />
      <h1>
        A surface for<br/>
        <span class="accent">agent work.</span>
      </h1>
      <p class="lede">
        The web gave humans a universal surface for information.
        String aims to give AI agents a universal surface for work —
        one interface to <b>read, navigate, act, and edit</b>
        across documents, apps, and the web.
      </p>

      <div class="agent-cta hero-agent-cta">
        <div class="agent-cta-label">Give this to your AI agent</div>
        <div class="agent-cta-row">
          <code class="agent-cta-text">{agentInstruction}</code>
          <button class="agent-cta-copy" data-copy={agentInstruction} type="button" aria-label="Copy instruction to clipboard">
            <span class="agent-cta-copy-default">Copy</span>
            <span class="agent-cta-copy-done">Copied</span>
          </button>
        </div>
      </div>

      <p class="platform-note">
        Linux and macOS today. On Windows, run String under <a href="https://learn.microsoft.com/windows/wsl/install" target="_blank" rel="noopener">WSL2</a>.
      </p>

      <div class="cta-row">
        <a class="cta secondary" href="https://docs.string-os.org">Read the docs →</a>
        <a class="cta secondary" href="https://github.com/string-os/string">GitHub</a>
      </div>
    </header>

    <!-- THE PATTERN — flowing prose, no eyebrow -->
    <section class="flow">
      <p>
        Today's agent tooling is islands. MCP, function calling, every framework
        lives in its own world. Each integration is a code project; each tool
        has its own shape. The agent learns each one separately, and pays for
        the schema in every call.
      </p>
      <p>
        String's bet is simpler. Every capability — a document, an app, a remote
        URL, an editable file — gets the <em>same</em> shape. The agent reads
        a markdown file the way it reads a webpage. Actions live inline.
        Navigation is by link. State is scoped per topic. New capability =
        new markdown file. No host config, no restart, same interface in any
        agent.
      </p>
    </section>

    <!-- FIVE SURFACES — quick visual taxonomy -->
    <section class="surfaces-section">
      <h2>Five surfaces. One runtime.</h2>
      <p class="body">
        Different domains an agent works against — the same primitives address
        them all.
      </p>
      <div class="surfaces">
        {surfaces.map(s => (
          <div class="surface">
            <div class="surface-kind">{s.kind}</div>
            <div class="surface-domain">{s.domain}</div>
            <code class="surface-verb">{s.verb}</code>
          </div>
        ))}
      </div>
    </section>

    <!-- A REAL APP — code + session -->
    <section class="demo">
      <h2>A real app, end to end.</h2>
      <p class="body">
        Below: a weather app — the entire app — and an agent session calling
        it. The agent reads the same file you do.
      </p>
      <div class="split">
        <div class="split-col">
          <div class="col-label">apps/weather/string.md</div>
          <pre class="code"><code>{weatherApp}</code></pre>
        </div>
        <div class="split-col">
          <div class="col-label">Agent session</div>
          <pre class="code terminal"><code>{agentSession}</code></pre>
        </div>
      </div>
    </section>

    <!-- DROP-IN (skill.md is the primary action; direct install is the footnote) -->
    <section class="install">
      <h2>Hand any AI agent this instruction.</h2>
      <p class="body">
        It reads the skill, installs String, and starts using apps. No SDK,
        no protocol negotiation, no per-agent integration code.
      </p>

      <div class="agent-cta install-agent-cta">
        <div class="agent-cta-label">Copy and paste into your AI agent</div>
        <div class="agent-cta-row">
          <code class="agent-cta-text">{agentInstruction}</code>
          <button class="agent-cta-copy" data-copy={agentInstruction} type="button" aria-label="Copy instruction to clipboard">
            <span class="agent-cta-copy-default">Copy</span>
            <span class="agent-cta-copy-done">Copied</span>
          </button>
        </div>
      </div>

      <p class="install-direct">
        Or install directly (for humans driving String themselves):
        <code>{installCommand}</code>
      </p>
      <p class="install-direct">
        Inspectable before they run: <code>/open</code> reads,
        <code>/act</code> performs work, and <code>/source</code> reveals
        the underlying SFMD — so an agent or a human can review an app
        before running it. v0.1 installs from trusted sources only.
      </p>
    </section>

    <!-- WHY IT PAYS OFF — quieter than before, mid-page -->
    <section class="numbers">
      <h2>Why it pays off.</h2>
      <div class="metrics">
        <div class="metric">
          <div class="metric-num">50–99<span class="unit">%</span></div>
          <div class="metric-label">fewer tokens per task</div>
          <div class="metric-detail">
            Tool descriptions live in the page, loaded only while the agent is using
            it. No global tool catalog padding every call.
          </div>
        </div>
        <div class="metric">
          <div class="metric-num">~50<span class="unit">%</span></div>
          <div class="metric-label">fewer task errors</div>
          <div class="metric-detail">
            Agents read markdown all day. Familiar interface plus self-discovery
            (next actions appear in the response) cut wrong-tool failures.
          </div>
        </div>
        <div class="metric">
          <div class="metric-num">1<span class="unit">×</span></div>
          <div class="metric-label">build, run anywhere</div>
          <div class="metric-detail">
            Same markdown app runs in Claude, Codex, Cursor, custom agents.
            Build once, deploy everywhere.
          </div>
        </div>
        <div class="metric">
          <div class="metric-num">~50<span class="unit"> lines</span></div>
          <div class="metric-label">per app, on average</div>
          <div class="metric-detail">
            An app is a markdown file. No build step, no schema, no host process.
            The file is the deliverable.
          </div>
        </div>
      </div>
      <p class="footnote">
        Numbers from early benchmarks comparing equivalent task completion across
        MCP, function calling, and String. Methodology in the docs.
      </p>
    </section>

    <!-- CLOSING -->
    <section class="close">
      <p class="close-line">
        Same primitives. Same shape. <span class="accent">The agent learns String once and uses everything.</span>
      </p>
      <div class="cta-row">
        <a class="cta primary" href="https://docs.string-os.org">Read the docs →</a>
        <a class="cta secondary" href="https://github.com/string-os/string">GitHub</a>
        <a class="cta secondary" href="/skill.md">skill.md</a>
      </div>
    </section>

    <footer class="footer">
      <div>String · open source · MIT</div>
      <div class="footer-links">
        <a href="https://docs.string-os.org">Docs</a>
        <a href="https://github.com/string-os/string">GitHub</a>
        <a href="https://github.com/string-os/sfmd">SFMD spec</a>
      </div>
    </footer>

    <style is:global>
      :root {
        --bg: #ffffff;
        --bg-2: #fbf7f3;
        --bg-3: #f4efe9;
        --fg: #16171b;
        --fg-muted: #565b63;
        --fg-dim: #8b9098;
        --accent: #f0603c;
        --accent-2: #ff7b54;
        --line: #ece7e0;
        --code-bg: #f7f5f2;
        --code-fg: #2b2f36;
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", system-ui, sans-serif;
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a { color: inherit; text-decoration: none; }

      code, pre {
        font-family: "JetBrains Mono", "SF Mono", ui-monospace, Menlo, monospace;
        font-size: 14px;
      }

      /* ── Top nav ────────────────────────────────────────────────────────── */
      .top {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 32px;
        border-bottom: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
      }
      .brand { font-weight: 700; font-size: 18px; letter-spacing: -0.01em; display: inline-flex; align-items: center; }
      .brand-logo { height: 28px; width: auto; display: block; }
      .nav-links { display: flex; gap: 28px; }
      .nav-links a { color: var(--fg-muted); font-size: 15px; transition: color 0.15s; }
      .nav-links a:hover { color: var(--fg); }

      /* ── Section rhythm — varied, not slide-uniform ─────────────────────── */
      header.hero,
      section {
        max-width: 920px;
        margin: 0 auto;
        padding: 80px 32px;
      }
      header.hero { padding-top: 120px; padding-bottom: 96px; }
      section.flow { padding-top: 0; padding-bottom: 56px; }
      section.surfaces-section { padding-top: 56px; padding-bottom: 80px; }
      section.demo { padding-top: 80px; padding-bottom: 80px; background: var(--bg-2); max-width: none; }
      section.demo > * { max-width: 920px; margin-left: auto; margin-right: auto; }
      section.install { padding-top: 88px; padding-bottom: 80px; }
      section.numbers { padding-top: 80px; padding-bottom: 80px; background: var(--bg-2); max-width: none; }
      section.numbers > * { max-width: 920px; margin-left: auto; margin-right: auto; }
      section.close { padding-top: 96px; padding-bottom: 96px; text-align: center; }

      /* ── Hero ───────────────────────────────────────────────────────────── */
      .hero-logo {
        height: 76px;
        width: auto;
        display: block;
        margin: 0 0 32px -6px;
      }
      @media (max-width: 620px) { .hero-logo { height: 60px; } }

      h1 {
        font-size: clamp(44px, 6vw, 72px);
        line-height: 1.05;
        letter-spacing: -0.025em;
        font-weight: 700;
        margin: 0 0 28px 0;
      }
      h1 .accent { color: var(--accent); }

      .lede {
        font-size: clamp(18px, 1.6vw, 22px);
        line-height: 1.55;
        color: var(--fg-muted);
        max-width: 720px;
        margin: 0 0 36px 0;
      }
      .lede b { color: var(--fg); font-weight: 600; }

      /* ── Agent CTA (copy-to-clipboard) ───────────────────────────────────
         Used in two places: prominently in the hero (above the secondary
         CTAs) and again in the install section. Same component, same JS
         hook — see the bottom-of-body <script>. */
      .agent-cta {
        padding: 22px 26px;
        background: linear-gradient(135deg, rgba(240, 96, 60, 0.07), rgba(255, 123, 84, 0.04));
        border: 1px solid rgba(240, 96, 60, 0.25);
        border-radius: 14px;
      }
      .agent-cta-label {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 12px;
      }
      .agent-cta-row {
        display: flex;
        gap: 14px;
        align-items: center;
      }
      .agent-cta-text {
        flex: 1;
        font-family: "JetBrains Mono", "SF Mono", ui-monospace, Menlo, monospace;
        font-size: 16px;
        line-height: 1.5;
        color: var(--fg);
        background: var(--code-bg);
        padding: 14px 16px;
        border-radius: 8px;
        border: 1px solid var(--line);
        word-break: break-word;
        user-select: all;
      }
      .agent-cta-copy {
        flex-shrink: 0;
        padding: 12px 22px;
        background: var(--accent);
        color: #fff;
        border: 0;
        border-radius: 8px;
        font-family: inherit;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s, transform 0.1s;
        min-width: 92px;
        position: relative;
      }
      .agent-cta-copy:hover { background: #ff8b66; transform: translateY(-1px); }
      .agent-cta-copy:active { transform: translateY(0); }
      .agent-cta-copy-done { display: none; }
      .agent-cta-copy.copied .agent-cta-copy-default { display: none; }
      .agent-cta-copy.copied .agent-cta-copy-done { display: inline; }

      /* Hero variant — larger and the visual centerpiece, sits above the
         secondary CTAs (Read docs / GitHub). */
      .hero-agent-cta {
        margin: 40px 0 32px;
        max-width: 720px;
        padding: 24px 28px;
        background: linear-gradient(135deg, rgba(240, 96, 60, 0.10), rgba(255, 123, 84, 0.05));
        border-color: rgba(240, 96, 60, 0.38);
        box-shadow: 0 6px 24px rgba(255, 123, 84, 0.12);
      }
      .hero-agent-cta .agent-cta-text { font-size: 17px; padding: 16px 18px; }

      @media (max-width: 620px) {
        .agent-cta-row { flex-direction: column; align-items: stretch; }
        .agent-cta-copy { width: 100%; }
      }

      /* Platform support note under the hero agent CTA */
      .platform-note {
        font-size: 13px;
        color: var(--fg-dim);
        margin: 0 0 32px;
      }
      .platform-note a {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .platform-note a:hover { color: var(--accent-2); }

      /* ── Flow prose (no eyebrow, just paragraphs that lead from hero) ──── */
      section.flow p {
        font-size: 19px;
        line-height: 1.7;
        color: var(--fg-muted);
        max-width: 720px;
        margin: 0 0 22px 0;
      }
      section.flow p em { color: var(--fg); font-style: italic; font-weight: 500; }

      /* ── Headings (smaller than before; less keynote) ───────────────────── */
      h2 {
        font-size: clamp(28px, 3vw, 38px);
        line-height: 1.2;
        letter-spacing: -0.015em;
        font-weight: 700;
        margin: 0 0 20px 0;
      }

      .body {
        font-size: 17px;
        line-height: 1.65;
        color: var(--fg-muted);
        max-width: 680px;
        margin: 0 0 28px 0;
      }
      .body code { background: var(--code-bg); padding: 2px 8px; border-radius: 4px; color: var(--accent); font-size: 0.92em; }

      /* ── CTAs ───────────────────────────────────────────────────────────── */
      .cta-row { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; justify-content: inherit; }
      .cta {
        display: inline-flex;
        align-items: center;
        padding: 12px 22px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 15px;
        transition: transform 0.1s, background 0.15s;
      }
      .cta:hover { transform: translateY(-1px); }
      .cta.primary { background: var(--accent); color: #fff; }
      .cta.primary:hover { background: #ff7048; }
      .cta.secondary { background: var(--bg-3); color: var(--fg); border: 1px solid var(--line); }
      .cta.secondary:hover { background: #ebe4dc; }

      /* ── Surfaces grid ──────────────────────────────────────────────────── */
      .surfaces {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 12px;
        margin-top: 24px;
      }
      .surface {
        padding: 18px 18px 16px;
        background: var(--bg-2);
        border: 1px solid var(--line);
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .surface-kind {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--accent);
        font-weight: 600;
      }
      .surface-domain {
        font-size: 17px;
        font-weight: 600;
        color: var(--fg);
      }
      .surface-verb {
        font-size: 13px;
        color: var(--fg-muted);
        background: var(--code-bg);
        padding: 4px 8px;
        border-radius: 4px;
        align-self: flex-start;
        margin-top: 4px;
      }

      /* ── Split panes (code + session) ───────────────────────────────────── */
      .split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 28px;
      }
      .split-col { min-width: 0; }
      .col-label {
        font-size: 12px;
        color: var(--fg-dim);
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 500;
      }
      @media (max-width: 800px) { .split { grid-template-columns: 1fr; } }

      /* ── Code blocks ────────────────────────────────────────────────────── */
      pre.code {
        margin: 0;
        padding: 20px 24px;
        background: var(--code-bg);
        border: 1px solid var(--line);
        border-radius: 10px;
        overflow-x: auto;
        line-height: 1.6;
        color: var(--code-fg);
      }
      pre.code.wide { max-width: 640px; margin: 0 0 32px 0; }
      pre.code.terminal { color: var(--fg-muted); }
      pre.code code { font-size: 13px; }

      /* Install-section variant uses the .agent-cta base; just give it spacing. */
      .install-agent-cta {
        margin: 8px 0 28px;
        max-width: 720px;
      }

      /* Direct-install footnote on the install section */
      .install-direct {
        font-size: 14px;
        color: var(--fg-dim);
        max-width: 640px;
        margin: 0;
      }
      .install-direct code {
        font-size: 13px;
        background: var(--code-bg);
        padding: 3px 8px;
        border-radius: 4px;
        color: var(--fg-muted);
        margin-left: 4px;
      }

      /* ── Numbers / metrics ──────────────────────────────────────────────── */
      .metrics {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        margin: 28px 0 24px;
      }
      .metric {
        padding: 24px 22px;
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: 12px;
      }
      .metric-num {
        font-size: 44px;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.02em;
        color: var(--accent);
        margin-bottom: 8px;
      }
      .metric-num .unit {
        font-size: 22px;
        color: var(--fg-muted);
        font-weight: 500;
        margin-left: 4px;
      }
      .metric-label {
        font-size: 16px;
        font-weight: 600;
        color: var(--fg);
        margin-bottom: 8px;
      }
      .metric-detail {
        font-size: 14px;
        line-height: 1.55;
        color: var(--fg-muted);
      }
      @media (max-width: 700px) {
        .metrics { grid-template-columns: 1fr; }
        .metric-num { font-size: 38px; }
      }
      .footnote {
        font-size: 13px;
        color: var(--fg-dim);
        max-width: 680px;
        font-style: italic;
        line-height: 1.5;
      }

      /* ── Close ──────────────────────────────────────────────────────────── */
      .close-line {
        font-size: clamp(22px, 2.6vw, 30px);
        line-height: 1.4;
        color: var(--fg-muted);
        max-width: 760px;
        margin: 0 auto 32px;
      }
      .close-line .accent { color: var(--fg); font-weight: 600; }
      section.close .cta-row { justify-content: center; }

      /* ── Footer ─────────────────────────────────────────────────────────── */
      .footer {
        max-width: 1100px;
        margin: 0 auto;
        padding: 32px 32px 56px;
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        color: var(--fg-dim);
        flex-wrap: wrap;
        gap: 16px;
        border-top: 1px solid var(--line);
      }
      .footer-links { display: flex; gap: 24px; }
      .footer-links a:hover { color: var(--fg); }

      /* Selection */
      ::selection { background: var(--accent); color: #fff; }
    </style>

    <script is:inline>
      // Copy-to-clipboard for [data-copy] buttons. Event-delegated so multiple
      // copy buttons share one listener. Shows "Copied" for 1500ms via a CSS
      // class toggle on the button.
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-copy]');
        if (!btn) return;
        const text = btn.getAttribute('data-copy');
        if (!text || !navigator.clipboard) return;
        navigator.clipboard.writeText(text).then(() => {
          btn.classList.add('copied');
          setTimeout(() => btn.classList.remove('copied'), 1500);
        }).catch(() => { /* clipboard blocked — text is still selectable */ });
      });
    </script>
  </body>
</html>
