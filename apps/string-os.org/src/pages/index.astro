---
const installCommand = `npm install -g @string-os/string`;
const skillUrl = `https://string-os.org/skill.md`;

const skillMdSnippet = `---
title: String — Install Skill
---

# Install String

This document tells you how to install and start using String.

## 1. Install
\`\`\`bash
npm install -g @string-os/string
\`\`\`

## 2. Start the daemon
\`\`\`bash
string --daemon start
\`\`\`

## 3. Install an app
\`\`\`bash
string file:setup '/install --app ./apps/weather/string.md'
\`\`\`

## 4. Use it
\`\`\`bash
string app:weather '/act.now --city Seoul'
\`\`\``;

const weatherApp = `---
name: weather
type: app
default: now
---

# Weather

\`\`\`act.now
GET https://wttr.in/{city}?format=%l:+%c+%t
  city, -c: string (required) "City name"
\`\`\`

\`\`\`act.forecast
GET https://wttr.in/{city}?format=j1
  city: string (required) "City name"
  days: number (optional) "Days to forecast" = "3"
\`\`\``;

const agentSession = `$ string app:weather '/act.now --city Seoul'

<𝒞=string:app:weather>
Seoul: ☀️ +23°C
</𝒞>

$ string app:weather '/act.forecast --city Tokyo --days 5'

<𝒞=string:app:weather>
Tokyo, 5-day forecast:
  Mon: ☀️ +28°C
  Tue: 🌤 +27°C
  Wed: 🌧 +22°C
  Thu: ⛅ +25°C
  Fri: ☀️ +29°C
</𝒞>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="String OS — apps for AI agents. Just markdown. Works in any agent. Up to 99% fewer tokens." />
    <meta property="og:title" content="String OS — Apps for AI agents. Just markdown." />
    <meta property="og:description" content="An AI-native runtime where capabilities are markdown documents. Up to 99% fewer tokens, ~50% fewer task errors." />
    <meta property="og:url" content="https://string-os.org" />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>String — Apps for AI agents. Just markdown.</title>
  </head>
  <body>
    <!-- Top nav -->
    <nav class="top">
      <a class="brand" href="/">String</a>
      <div class="nav-links">
        <a href="https://docs.string-os.org">Docs</a>
        <a href="/skill.md">skill.md</a>
        <a href="https://github.com/string-os/string">GitHub</a>
      </div>
    </nav>

    <!-- Hero -->
    <section class="section hero">
      <div class="eyebrow">String OS</div>
      <h1>Apps for AI agents.<br/><span class="accent">Just markdown.</span></h1>
      <p class="lede">
        An AI-native runtime where every capability is a markdown document.
        One interface for every tool. Up to <b>99% fewer tokens</b>,
        ~<b>50% fewer task errors</b>.
      </p>
      <div class="cta-row">
        <a class="cta primary" href="https://docs.string-os.org">Read the docs →</a>
        <a class="cta secondary" href="https://github.com/string-os/string">GitHub</a>
      </div>
      <div class="hero-install">
        <code>{installCommand}</code>
      </div>
    </section>

    <!-- What is String -->
    <section class="section define">
      <div class="eyebrow">What is String OS?</div>
      <h2>Capabilities are documents, not programs.</h2>
      <p class="body">
        Every tool an AI agent uses today has its own interface — REST APIs need endpoint
        URLs and JSON schemas, MCP servers need protocol negotiation, CLI tools need
        argument parsing. Each integration is a code project.
      </p>
      <p class="body">
        String makes every capability a markdown file. The agent reads it the same way
        it reads a webpage. Actions live inline. Navigation is by link. State is
        scoped per app. New capability = new markdown file. No host config. No restart.
        Same interface in any agent.
      </p>

      <div class="diagram">
        <div class="node user">AI agent</div>
        <div class="arrow">↔</div>
        <div class="node runtime">String runtime<br/><span>open · act · nav</span></div>
        <div class="arrow">↔</div>
        <div class="node apps">
          <span class="md-card">weather.md</span>
          <span class="md-card">moltbook.md</span>
          <span class="md-card">gmail.md</span>
        </div>
      </div>
    </section>

    <!-- The artifact: skill.md -->
    <section class="section artifact">
      <div class="eyebrow">Drop this into your AI agent.</div>
      <h2>One link. Your agent installs String and starts using apps.</h2>

      <div class="link-card">
        <div class="link-label">Share this URL with any AI agent:</div>
        <code class="link-url">{skillUrl}</code>
      </div>

      <div class="split">
        <div class="split-col">
          <div class="col-label">skill.md (excerpt)</div>
          <pre class="code"><code>{skillMdSnippet}</code></pre>
        </div>
        <div class="split-col">
          <div class="col-label">What the agent does</div>
          <ol class="steps">
            <li>Reads the skill.md document</li>
            <li>Runs <code>npm install -g @string-os/string</code></li>
            <li>Starts the daemon</li>
            <li>Installs apps from URLs or local paths</li>
            <li>Calls <code>/act.&lt;name&gt;</code> on any app — same interface every time</li>
          </ol>
        </div>
      </div>
    </section>

    <!-- The artifact: an app -->
    <section class="section app-demo">
      <div class="eyebrow">A String App</div>
      <h2>This file is the entire app.</h2>
      <p class="body">
        50 lines of markdown. Read it, fork it, audit it, edit it. The agent reads the
        same file you do.
      </p>

      <div class="split">
        <div class="split-col">
          <div class="col-label">apps/weather/string.md</div>
          <pre class="code"><code>{weatherApp}</code></pre>
        </div>
        <div class="split-col">
          <div class="col-label">Agent session</div>
          <pre class="code terminal"><code>{agentSession}</code></pre>
        </div>
      </div>
    </section>

    <!-- Why String -->
    <section class="section why">
      <div class="eyebrow">Why String?</div>
      <h2>Cheaper to run. Better at the task.</h2>

      <div class="metrics">
        <div class="metric">
          <div class="metric-num">50–99<span class="unit">%</span></div>
          <div class="metric-label">fewer tokens per task</div>
          <div class="metric-detail">
            Tool descriptions live in the page, loaded only while the agent is using
            it. No global tool catalog padding every call.
          </div>
        </div>
        <div class="metric">
          <div class="metric-num">~50<span class="unit">%</span></div>
          <div class="metric-label">fewer task errors</div>
          <div class="metric-detail">
            Agents read markdown all day. Familiar interface plus self-discovery
            (next actions are right in the response) cut wrong-tool failures.
          </div>
        </div>
        <div class="metric">
          <div class="metric-num">1<span class="unit">×</span></div>
          <div class="metric-label">build, run anywhere</div>
          <div class="metric-detail">
            Same markdown app runs in Claude, Codex, Cursor, custom agents.
            Build once, deploy everywhere.
          </div>
        </div>
        <div class="metric">
          <div class="metric-num">50<span class="unit"> lines</span></div>
          <div class="metric-label">per app, on average</div>
          <div class="metric-detail">
            An app is a markdown file. No build step, no schema, no host process.
            The file is the deliverable.
          </div>
        </div>
      </div>

      <p class="footnote">
        Numbers from early benchmarks comparing equivalent task completion across
        MCP, function calling, and String. Detailed methodology in the docs.
      </p>
    </section>

    <!-- The deeper insight -->
    <section class="section insight">
      <div class="eyebrow">The deeper pattern</div>
      <h2>The web for AI agents.</h2>
      <p class="body big">
        The web works because pages link to pages. AI tooling today is islands —
        MCP, function calling, every framework lives in its own world.
      </p>
      <p class="body big">
        String unifies them with two verbs an agent already knows:
        <code>/open</code> any document, <code>/act</code> on any capability.
        Responses contain links. Links open more documents. Capabilities compose
        the same way pages do.
      </p>
      <p class="body big accent-line">
        That's the whole game.
      </p>
    </section>

    <!-- Get started -->
    <section class="section start">
      <div class="eyebrow">Get started</div>
      <h2>Three commands.</h2>
      <pre class="code wide"><code>{`npm install -g @string-os/string
string --daemon start
string file:setup '/install --app ./apps/weather/string.md'`}</code></pre>
      <div class="cta-row">
        <a class="cta primary" href="https://docs.string-os.org">Read the docs →</a>
        <a class="cta secondary" href="https://github.com/string-os/string">GitHub</a>
        <a class="cta secondary" href="/skill.md">skill.md</a>
      </div>
    </section>

    <footer class="footer">
      <div>String OS · open source · MIT</div>
      <div class="footer-links">
        <a href="https://docs.string-os.org">Docs</a>
        <a href="https://github.com/string-os/string">GitHub</a>
        <a href="https://github.com/string-os/sfmd">SFMD spec</a>
      </div>
    </footer>

    <style is:global>
      :root {
        --bg: #08090d;
        --bg-2: #0e1015;
        --bg-3: #161922;
        --fg: #f5f5f7;
        --fg-muted: #9aa0a8;
        --fg-dim: #6b7280;
        --accent: #ffb454;
        --accent-2: #ff7b54;
        --line: #1f2330;
        --code-bg: #0a0c11;
        --code-fg: #c9d1d9;
        --keyword: #ff7b54;
        --string: #b8d68c;
        --comment: #6b7280;
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", system-ui, sans-serif;
        font-size: 17px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a { color: inherit; text-decoration: none; }

      code, pre {
        font-family: "JetBrains Mono", "SF Mono", ui-monospace, Menlo, monospace;
        font-size: 14px;
      }

      .top {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 32px;
        border-bottom: 1px solid var(--line);
        background: rgba(8, 9, 13, 0.85);
        backdrop-filter: blur(12px);
      }
      .brand { font-weight: 700; font-size: 18px; letter-spacing: -0.01em; }
      .nav-links { display: flex; gap: 28px; }
      .nav-links a { color: var(--fg-muted); font-size: 15px; transition: color 0.15s; }
      .nav-links a:hover { color: var(--fg); }

      .section {
        max-width: 1100px;
        margin: 0 auto;
        padding: 120px 32px;
        border-bottom: 1px solid var(--line);
      }

      .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 13px;
        color: var(--accent);
        font-weight: 600;
        margin-bottom: 24px;
      }

      h1 {
        font-size: clamp(48px, 7vw, 88px);
        line-height: 1.05;
        letter-spacing: -0.025em;
        font-weight: 700;
        margin: 0 0 32px 0;
      }
      h1 .accent { color: var(--accent); }

      h2 {
        font-size: clamp(36px, 5vw, 60px);
        line-height: 1.1;
        letter-spacing: -0.02em;
        font-weight: 700;
        margin: 0 0 32px 0;
      }

      .lede {
        font-size: 22px;
        line-height: 1.5;
        color: var(--fg-muted);
        max-width: 680px;
        margin: 0 0 40px 0;
      }
      .lede b { color: var(--fg); font-weight: 600; }

      .body {
        font-size: 19px;
        line-height: 1.6;
        color: var(--fg-muted);
        max-width: 760px;
        margin: 0 0 24px 0;
      }
      .body.big { font-size: 24px; line-height: 1.5; max-width: 820px; }
      .body code { background: var(--code-bg); padding: 2px 8px; border-radius: 4px; color: var(--accent); font-size: 0.92em; }
      .body.big code { font-size: 0.86em; }
      .accent-line { color: var(--accent); font-weight: 600; }

      .cta-row { display: flex; gap: 16px; flex-wrap: wrap; align-items: center; }
      .cta {
        display: inline-flex;
        align-items: center;
        padding: 14px 24px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 16px;
        transition: transform 0.1s, background 0.15s;
      }
      .cta:hover { transform: translateY(-1px); }
      .cta.primary { background: var(--accent); color: #1a1206; }
      .cta.primary:hover { background: #ffc070; }
      .cta.secondary { background: var(--bg-3); color: var(--fg); border: 1px solid var(--line); }
      .cta.secondary:hover { background: #1d2230; }

      .hero-install {
        margin-top: 56px;
        padding: 18px 22px;
        background: var(--code-bg);
        border: 1px solid var(--line);
        border-radius: 10px;
        font-family: "JetBrains Mono", ui-monospace, monospace;
        color: var(--fg-muted);
        max-width: 480px;
        font-size: 15px;
      }
      .hero-install::before { content: "$ "; color: var(--fg-dim); }

      /* Diagram */
      .diagram {
        display: flex;
        align-items: center;
        gap: 24px;
        margin-top: 56px;
        padding: 40px 32px;
        background: var(--bg-2);
        border: 1px solid var(--line);
        border-radius: 14px;
        flex-wrap: wrap;
      }
      .node {
        flex: 1;
        min-width: 180px;
        padding: 24px;
        background: var(--bg-3);
        border: 1px solid var(--line);
        border-radius: 10px;
        text-align: center;
        font-weight: 600;
      }
      .node.runtime { border-color: var(--accent); }
      .node span { display: block; font-weight: 400; color: var(--fg-muted); font-size: 14px; margin-top: 6px; font-family: monospace; }
      .arrow { color: var(--fg-dim); font-size: 24px; }
      .node.apps { display: flex; flex-direction: column; gap: 8px; padding: 16px; }
      .md-card {
        display: block;
        padding: 8px 12px;
        background: var(--bg-2);
        border-radius: 6px;
        font-family: monospace;
        font-size: 14px;
        color: var(--accent);
        font-weight: 400;
      }

      /* Link card (skill.md prominent) */
      .link-card {
        margin: 32px 0 56px;
        padding: 28px 32px;
        background: linear-gradient(135deg, rgba(255, 180, 84, 0.08), rgba(255, 123, 84, 0.04));
        border: 1px solid rgba(255, 180, 84, 0.3);
        border-radius: 14px;
      }
      .link-label { color: var(--fg-muted); font-size: 14px; margin-bottom: 8px; }
      .link-url {
        font-size: clamp(20px, 3vw, 28px);
        color: var(--accent);
        font-weight: 600;
        word-break: break-all;
      }

      /* Split layout for code/explanation */
      .split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-top: 32px;
      }
      .split-col { min-width: 0; }
      .col-label {
        font-size: 13px;
        color: var(--fg-dim);
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 500;
      }
      @media (max-width: 800px) {
        .split { grid-template-columns: 1fr; }
      }

      /* Code blocks */
      pre.code {
        margin: 0;
        padding: 24px 28px;
        background: var(--code-bg);
        border: 1px solid var(--line);
        border-radius: 10px;
        overflow-x: auto;
        line-height: 1.6;
        color: var(--code-fg);
      }
      pre.code.wide {
        max-width: 760px;
        margin: 0 0 40px 0;
      }
      pre.code.terminal { color: var(--fg-muted); }
      pre.code code { font-size: 14px; }

      /* Steps */
      .steps {
        list-style: none;
        padding: 0;
        margin: 0;
        counter-reset: step;
      }
      .steps li {
        position: relative;
        padding: 14px 0 14px 44px;
        font-size: 16px;
        color: var(--fg-muted);
        line-height: 1.5;
        counter-increment: step;
        border-bottom: 1px solid var(--line);
      }
      .steps li:last-child { border-bottom: none; }
      .steps li::before {
        content: counter(step);
        position: absolute;
        left: 0;
        top: 14px;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--bg-3);
        border: 1px solid var(--accent);
        color: var(--accent);
        font-size: 13px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: monospace;
      }
      .steps li code { background: var(--code-bg); padding: 2px 6px; border-radius: 4px; color: var(--accent); font-size: 13px; }

      /* Metrics */
      .metrics {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin: 48px 0 32px;
      }
      .metric {
        padding: 32px 28px;
        background: var(--bg-2);
        border: 1px solid var(--line);
        border-radius: 14px;
      }
      .metric-num {
        font-size: 64px;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.03em;
        color: var(--accent);
        margin-bottom: 8px;
      }
      .metric-num .unit {
        font-size: 28px;
        color: var(--fg-muted);
        font-weight: 500;
        margin-left: 4px;
      }
      .metric-label {
        font-size: 17px;
        font-weight: 600;
        color: var(--fg);
        margin-bottom: 12px;
      }
      .metric-detail {
        font-size: 15px;
        line-height: 1.5;
        color: var(--fg-muted);
      }
      @media (max-width: 700px) {
        .metrics { grid-template-columns: 1fr; }
        .metric-num { font-size: 56px; }
      }
      .footnote {
        font-size: 13px;
        color: var(--fg-dim);
        max-width: 680px;
        font-style: italic;
        line-height: 1.5;
      }

      /* Insight section */
      .section.insight { background: linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 100%); }
      .section.insight h2 { font-size: clamp(40px, 6vw, 72px); }

      /* Hero */
      .section.hero { padding-top: 80px; padding-bottom: 140px; }

      /* Footer */
      .footer {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 32px 60px;
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        color: var(--fg-dim);
        flex-wrap: wrap;
        gap: 16px;
      }
      .footer-links { display: flex; gap: 24px; }
      .footer-links a:hover { color: var(--fg); }

      /* Selection */
      ::selection { background: var(--accent); color: #1a1206; }
    </style>
  </body>
</html>
